{"file_path": "contracts/FTSO/sNative.sol", "creation_status": "success", "source_code": "\n// SPDX-License-Identifier: MIT\npragma solidity ^0.8;\nimport \"./IExchangeableAsset.sol\";\n\ninterface ISNative{\n    function getPooledFlrByShares (uint shareAmount) external view returns (uint);\n    function decimals() external view returns (uint8);\n}\n\ncontract sNative is IExchangeableAsset {\n  /// @notice Staked native token\n  ISNative public sNativeToken;\n  /// @notice Staked native token decimals\n  uint8 public decimals;\n\n  constructor(ISNative _sNativeToken) {\n    // sanity check\n    _sNativeToken.getPooledFlrByShares(1e18);\n\n    sNativeToken = _sNativeToken;\n    decimals = _sNativeToken.decimals();\n\n    require(decimals == 18, 'invalid token');\n  }\n\n  function getExchangeRate() external view returns (uint){\n    return sNativeToken.getPooledFlrByShares(10**(uint(decimals)));\n  }\n}", "deployed_bytecode": "", "optimization_enabled": true, "verified_twin_address_hash": null, "is_verified": true, "compiler_settings": {"libraries": {}, "optimizer": {"enabled": true, "runs": 200}, "outputSelection": {"*": {"": ["*"], "*": ["*"]}}}, "optimization_runs": 200, "sourcify_repo_url": null, "decoded_constructor_args": [["0x12e605bc104e93B45e1aD99F9e555f659051c2BB", {"internalType": "contract ISNative", "name": "_sNativeToken", "type": "address"}]], "compiler_version": "v0.8.17+commit.8df45f5f", "is_verified_via_verifier_alliance": null, "verified_at": "2024-08-06T22:57:46.677311Z", "implementations": [], "proxy_type": null, "external_libraries": [], "creation_bytecode": "", "name": "sNative", "is_blueprint": false, "license_type": "none", "is_fully_verified": true, "is_verified_via_eth_bytecode_db": false, "language": "solidity", "evm_version": "default", "can_be_visualized_via_sol2uml": false, "is_verified_via_sourcify": false, "additional_sources": [{"file_path": "contracts/FTSO/IExchangeableAsset.sol", "source_code": "// SPDX-License-Identifier: MIT\nint