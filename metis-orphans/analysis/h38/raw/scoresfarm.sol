pragma solidity ^0.6.12;
pragma experimental ABIEncoderV2;







contract ScoresFarm is Ownable {
    using SafeMath for uint256;
    using BoringERC20 for IERC20;
    using EnumerableSet for EnumerableSet.AddressSet;

    // Info of each user
    struct UserInfo {
        uint256 amount;
        uint256 scoreDebt;
        uint256 accScores;
    }

    struct PoolInfo {
        IERC20 lpToken;
        uint256 allocPoint;
        uint256 lastUpdateTimestamp;
        uint256 accScoresPerShare;
        uint256 lpSupply;
    }

    // 200K allocation points for this farm
    uint256 public constant TOTAL_SCORES = 200000 * 1e18;
    uint256 public remainingScores = 200000 * 1e18;
    uint256 public startTimestamp;
    uint256 public endTimestamp;
    uint256 public duration;
    uint256 public scoresPerSec;
    uint256 public totalAllocPoint;

    PoolInfo[] public poolInfo;
    EnumerableSet.AddressSet private lpTokens;
    // Info of each user that stakes LP tokens for a specific pool.
    mapping(uint256 => mapping(address => UserInfo)) public userInfo;
    
    constructor(
        uint256 _startTimestamp,
        uint256 _duration
    ) public {
        require(_startTimestamp > block.timestamp, "invalid start timestamp");
        require(_duration > 0, "invalid duration");
        startTimestamp = _startTimestamp;
        duration = _duration;
        endTimestamp = startTimestamp.add(duration);
        scoresPerSec = TOTAL_SCORES.div(duration);
        totalAllocPoint = 0;
    }

    function poolLength() external view returns (uint256) {
        return poolInfo.length;
    }

    function pendingScores(uint256 _pid, address _user) public view returns(uint256) {
        PoolInfo storage pool = poolInfo[_pid];
        UserInfo storage user = userInfo[_pid][_user];
        uint256 accScoresPerShare = pool.accScoresPerShare;
        uint256 lpSupply = pool.lpSupply;
        uint256 updateTime = block.timestamp > endTimestamp ? endTimestamp : block.timestamp;
        if (updateTime > pool.lastUpdateTimestamp && lpSupply != 0 && totalAllocPoint > 0) {
            uint256 multiplier = updateTime.sub(pool.lastUpdateTimestamp);
            uint256 scores = multiplier.mul(scoresPerSec).mul(pool.allocPoint).div(totalAllocPoint);
            accScoresPerShare = accScoresPerShare.add(scores.mul(1e12).div(lpSupply));
        }
        return user.amount.mul(accScoresPerShare).div(1e12).sub(user.scoreDebt);
    }

    function accScoresPerUser(address _user) public view returns (uint256) {
        uint256 length = poolInfo.length;
        uint256 accScores = 0;
        for (uint256 pid = 0; pid < length; ++pid) {
            accScores += userInfo[pid][_user].accScores;
            accScores += pendingScores(pid, _user);
        }
        return accScores;
    }

    function add(
        uint256 _allocPoint,
        IERC20 _lpToken
    ) public onlyOwner {
        require(Address.isContract(address(_lpToken)), "add: LP token must be a valid contract");
        require(!lpTokens.contains(address(_lpToken)), "add: LP already added");
        massUpdatePools();
        uint256 lastUpdateTimestamp = block.timestamp > startTimestamp ? block.timestamp : startTimestamp;
        totalAllocPoint = totalAllocPoint.add(_allocPoint);
        poolInfo.push(
            PoolInfo({
                lpToken: _lpToken,
                allocPoint: _allocPoint,
                lastUpdateTimestamp: lastUpdateTimestamp,
                accScoresPerShare: 0,
                lpSupply: 0
            })
        );
        lpTokens.add(address(_lpToken));
        emit Add(poolInfo.length.sub(1), _allocPoint, _lpToken);
    }

    function set(
        uint256 _pid,
        uint256 _allocPoint
    ) public onlyOwner {
        massUpdatePools();
        totalAllocPoint = totalAllocPoint.sub(poolInfo[_pid].allocPoint).add(_allocPoint);
        poolInfo[_pid].allocPoint = _allocPoint;
        emit Set(_pid, _allocPoint);
    }

    function massUpdatePools() public {
        uint256 length = poolInfo.length;
        for (uint256 pid = 0; pid < length; ++pid) {
            updatePool(pid);
        }
    }

    function updatePool(uint256 _pid) public {
        PoolInfo storage pool = poolInfo[_pid];
        if (block.timestamp <= pool.lastUpdateTimestamp) {
            return;
        }
        uint256 lpSupply = pool.lpSupply;
        uint256 updateTime = block.timestamp > endTimestamp ? endTimestamp : block.timestamp;
        if (lpSupply == 0) {
            pool.lastUpdateTimestamp = updateTime;
            return;
        }
        uint256 multiplier = updateTime.sub(pool.lastUpdateTimestamp);
        uint256 scores = totalAllocPoint > 0 ? multiplier.mul(scoresPerSec).mul(pool.allocPoint).div(totalAllocPoint) : 0;
        remainingScores = TOTAL_SCORES.sub(scores);
        pool.accScoresPerShare = pool.accScoresPerShare.add(scores.mul(1e12).div(lpSupply));
        pool.lastUpdateTimestamp = updateTime;
        emit UpdatePool(_pid, pool.lastUpdateTimestamp, lpSupply, pool.accScoresPerShare);
    }

    function deposit(uint256 _pid, uint256 _amount) public onlyAllowToDeposit {
        PoolInfo storage pool = poolInfo[_pid];
        UserInfo storage user = userInfo[_pid][msg.sender];
        updatePool(_pid);
        if (user.amount > 0) {
            // Store acc scores
            uint256 pending = user.amount.mul(pool.accScoresPerShare).div(1e12).sub(user.scoreDebt);
            user.accScores = user.accScores.add(pending);
            emit AccScoresStored(msg.sender, _pid, pending);
        }
        user.amount = user.amount.add(_amount);
        user.scoreDebt = user.amount.mul(pool.accScoresPerShare).div(1e12);

        pool.lpSupply = pool.lpSupply.add(_amount);
        pool.lpToken.safeTransferFrom(msg.sender, address(this), _amount);
        emit Deposit(msg.sender, _pid, _amount);
    }

    function withdraw(uint256 _pid, uint256 _amount) public {
        PoolInfo storage pool = poolInfo[_pid];
        UserInfo storage user = userInfo[_pid][msg.sender];
        require(user.amount >= _amount, "withdraw: not good");

        updatePool(_pid);

        if (user.amount > 0) {
            // Store acc scores
            uint256 pending = user.amount.mul(pool.accScoresPerShare).div(1e12).sub(user.scoreDebt);
            user.accScores = user.accScores.add(pending);
            emit AccScoresStored(msg.sender, _pid, pending);
        }

        user.amount = user.amount.sub(_amount);
        user.scoreDebt = user.amount.mul(pool.accScoresPerShare).div(1e12);

        pool.lpSupply = pool.lpSupply.sub(_amount);
        pool.lpToken.safeTransfer(msg.sender, _amount);
        emit Withdraw(msg.sender, _pid, _amount);
    }

    // Withdraw without caring about scores. EMERGENCY ONLY.
    function emergencyWithdraw(uint256 _pid) public {
        PoolInfo storage pool = poolInfo[_pid];
        UserInfo storage user = userInfo[_pid][msg.sender];
        pool.lpToken.safeTransfer(msg.sender, user.amount);
        pool.lpSupply = pool.lpSupply.sub(user.amount);
        emit EmergencyWithdraw(msg.sender, _pid, user.amount);
        user.amount = 0;
        user.scoreDebt = 0;
    }

    modifier onlyAllowToDeposit() {
        require(block.timestamp < endTimestamp, "ended");
        _;
    }

    event Add(uint256 indexed pid, uint256 allocPoint, IERC20 indexed lpToken);
    event Set(uint256 indexed pid, uint256 allocPoint);
    event Deposit(address indexed user, uint256 indexed pid, uint256 amount);
    event Withdraw(address indexed user, uint256 indexed pid, uint256 amount);
    event UpdatePool(uint256 indexed pid, uint256 lastUpdateTimestamp, uint256 lpSupply, uint256 accScoresPerShare);
    event AccScoresStored(address indexed user, uint256 indexed pid, uint256 scores);
    event EmergencyWithdraw(address indexed user, uint256 indexed pid, uint256 amount);
    event UpdateEmissionRate(address indexed user, uint256 _scoresPerSec);
}
