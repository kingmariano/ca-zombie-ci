IKE holders may participate in proposal voting directly or through delegates.\n\nStakeholders of a book share in book sale income, aligning incentives between creators and consumers. This fosters a community-driven literary ecosystem where books, as NFTs, are co-curated and co-monetized."},"links":{"homepage":["https://like.co/","https://3ook.com"],"whitepaper":"https://3ook.com/store/0x3ddc416c403449bc2a9ae873bff0b687993cd662","blockchain_site":["https://basescan.org/token/0x1EE5DD1794C28F559f94d2cc642BaE62dC3be5cf","https://intel.arkm.com/explorer/token/likecoin-2","https://atomscan.com/likecoin"],"official_forum_url":["https://newsletter.like.co/","https://www.threads.com/@3ookcom","https://www.instagram.com/3ookcom"],"chat_url":["https://discord.com/invite/likecoin","https://www.youtube.com/likecoin"],"announcement_url":["https://docs.like.co","https://medium.com/likecoin"],"snapshot_url":null,"twitter_screen_name":"likecoin","facebook_username":"Liker.Land","bitcointalk_thread_identifier":null,"telegram_channel_identifier":"","subreddit_url":"https://www.reddit.com/r/LikeCoin/","repos_url":{"github":["https://github.com/likecoin/"],"bitbucket":[]}},"image":{"thumb":"https://coin-images.coingecko.com/coins/images/69458/thumb/likecoin.png?1758647439","small":"https://coin-images.coingecko.com/coins/images/69458/small/likecoin.png?1758647439","large":"https://coin-images.coingecko.com/coins/images/69458/large/likecoin.png?1758647439"},"country_origin":"","genesis_date":null,"listing_price":null,"listing_currency":null,"listing_timestamp":null,"listing_source":null,"listing_source_url":null,"contract_address":"0x1ee5dd1794c28f559f94d2cc642bae62dc3be5cf","has_supply_breakdown":true,"sentiment_votes_up_percentage":null,"sentiment_votes_down_percentage":null,"watchlist_portfolio_users":58,"market_cap_rank":2470,"market_cap_rank_with_rehypothecated":2924,"market_data":{"current_price":{"vef":0.00014557,"btc":1.7733e-08,"bits":0.0177332,"sats":1.77,"eth":5.8262e-07,"ltc