", "type": "uint256"}, {"indexed": false, "name": "isContribution", "type": "bool"}], "name": "FundTransfer", "type": "event"}, {"anonymous": false, "inputs": [{"indexed": true, "name": "previousOwner", "type": "address"}, {"indexed": true, "name": "newOwner", "type": "address"}], "name": "OwnershipTransferred", "type": "event"}], "is_changed_bytecode": false, "is_partially_verified": true, "constructor_args": ""}